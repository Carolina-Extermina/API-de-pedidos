generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id          String   @id @default(uuid())
  orderId     String   @unique
  value       Int
  creationDate DateTime
  items       Item[]
}

model Item {
  id         String @id @default(uuid())
  orderId    String
  productId  String
  quantity   Int
  price      Int
  
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
